<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="co.edu.uniquindio.gestionalojamiento.controladores.PreparacionController"
      spacing="20"
      style="-fx-background-color: #F4F6F9;">

    <padding>
        <Insets top="30" right="35" bottom="30" left="35"/>
    </padding>

    <Label text="Preparación de apartamentos"
           style="-fx-font-size: 26px;
                  -fx-font-weight: bold;
                  -fx-text-fill: #243447;"/>

    <Label text="Consulta los apartamentos pendientes y administra su proceso de limpieza y preparación."
           wrapText="true"
           style="-fx-font-size: 14px;
                  -fx-text-fill: #455A64;"/>

    <HBox spacing="25">
        <Label fx:id="lblPendientes"
               text="Apartamentos pendientes: 0"
               style="-fx-font-size: 15px;
                      -fx-font-weight: bold;"/>

        <Label fx:id="lblSiguiente"
               text="Siguiente apartamento: ninguno"
               wrapText="true"
               style="-fx-font-size: 15px;"/>
    </HBox>

    <Label fx:id="lblEnPreparacion"
           text="En preparación: ninguno"
           style="-fx-font-size: 15px;
                  -fx-font-weight: bold;
                  -fx-text-fill: #455A64;"/>

    <TableView fx:id="tablaApartamentos"
               VBox.vgrow="ALWAYS"
               prefHeight="350">

        <columns>
            <TableColumn fx:id="colCodigo"
                         text="Código"
                         prefWidth="150"/>

            <TableColumn fx:id="colNombre"
                         text="Nombre"
                         prefWidth="250"/>

            <TableColumn fx:id="colEstado"
                         text="Estado"
                         prefWidth="220"/>
        </columns>
    </TableView>

    <HBox spacing="15">
        <Button fx:id="btnIniciar"
                text="Iniciar preparación"
                onAction="#iniciarPreparacion"
                style="-fx-background-color: #2471A3;
                       -fx-text-fill: white;
                       -fx-font-weight: bold;
                       -fx-padding: 10 20 10 20;"/>

        <Button fx:id="btnFinalizar"
                text="Finalizar preparación"
                onAction="#finalizarPreparacion"
                style="-fx-background-color: #239B56;
                       -fx-text-fill: white;
                       -fx-font-weight: bold;
                       -fx-padding: 10 20 10 20;"/>

        <Button text="Actualizar"
                onAction="#actualizarTabla"
                style="-fx-padding: 10 20 10 20;"/>
    </HBox>

</VBox>
