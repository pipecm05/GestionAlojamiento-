<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="co.edu.uniquindio.gestionalojamiento.controladores.FolioController"
      spacing="15"
      style="-fx-background-color: #F4F6F9;">

    <padding>
        <Insets top="25" right="25" bottom="25" left="25"/>
    </padding>

    <Label text="Gestión del folio"
           style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #243447;"/>

    <Label text="Consulta los movimientos, registra cargos y pagos, y conserva el historial de cada reserva."
           wrapText="true"/>

    <HBox spacing="12" alignment="CENTER_LEFT">
        <Label text="Reserva:"/>
        <ComboBox fx:id="cbReserva"
                  prefWidth="220"
                  promptText="Selecciona una reserva"/>
        <Button text="Actualizar reservas"
                onAction="#actualizarReservas"/>
    </HBox>

    <Label fx:id="lblReserva"
           text="Selecciona una reserva para consultar su folio."
           wrapText="true"
           style="-fx-font-size: 14px; -fx-text-fill: #455A64;"/>

    <HBox spacing="15" alignment="CENTER_LEFT">
        <Label text="Saldo actual:"/>
        <Label fx:id="lblSaldo"
               text="0"
               style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #243447;"/>

        <Label text="Movimientos:"/>
        <Label fx:id="lblCantidadMovimientos"
               text="0 movimientos"/>
    </HBox>

    <Label text="Registrar movimiento"
           style="-fx-font-size: 19px; -fx-font-weight: bold;"/>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Código:"/>
        <TextField fx:id="txtCodigo"
                   promptText="Ej. MOV-001"
                   prefWidth="140"/>

        <Label text="Tipo:"/>
        <ComboBox fx:id="cbTipoMovimiento"
                  prefWidth="120"/>
    </HBox>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Descripción:"/>
        <TextField fx:id="txtDescripcion"
                   promptText="Concepto del movimiento"
                   prefWidth="350"/>
    </HBox>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Valor (COP):"/>
        <TextField fx:id="txtValor"
                   promptText="Ej. 150000"
                   prefWidth="150"/>

        <Button text="Registrar movimiento"
                onAction="#registrarMovimiento"
                style="-fx-background-color: #243447; -fx-text-fill: white;"/>
    </HBox>

    <Button text="Deshacer última operación"
            onAction="#deshacerUltimoMovimiento"
            style="-fx-background-color: #9B3D36; -fx-text-fill: white;"/>

    <Label text="Historial de movimientos"
           style="-fx-font-size: 19px; -fx-font-weight: bold;"/>

    <TableView fx:id="tablaMovimientos"
               prefHeight="280">
        <columns>
            <TableColumn fx:id="colCodigo"
                         text="Código"
                         prefWidth="120"/>

            <TableColumn fx:id="colDescripcion"
                         text="Descripción"
                         prefWidth="250"/>

            <TableColumn fx:id="colTipo"
                         text="Tipo"
                         prefWidth="90"/>

            <TableColumn fx:id="colValor"
                         text="Valor"
                         prefWidth="130"/>

            <TableColumn fx:id="colFecha"
                         text="Fecha"
                         prefWidth="160"/>
        </columns>
    </TableView>

</VBox>
