<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.edu.uniquindio.gestionalojamiento.controladores.ReservaController"
            fitToWidth="true"
            hbarPolicy="NEVER"
            vbarPolicy="AS_NEEDED"
            style="-fx-background: #F4F6F9;">

    <content>
        <VBox spacing="14"
              style="-fx-background-color: #F4F6F9;">

            <padding>
                <Insets top="25" right="25" bottom="25" left="25"/>
            </padding>

            <Label text="Gestión de reservas"
                   style="-fx-font-size: 26px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #243447;"/>

            <Label text="Registro, disponibilidad y consulta de reservas."/>

            <!-- RESERVA INDIVIDUAL -->
            <TitledPane text="Registrar reserva individual"
                        collapsible="false">
                <content>
                    <GridPane hgap="12" vgap="12">
                        <padding>
                            <Insets top="15" right="15" bottom="15" left="15"/>
                        </padding>

                        <Label text="Código:"
                               GridPane.rowIndex="0"
                               GridPane.columnIndex="0"/>

                        <TextField fx:id="txtCodigo"
                                   promptText="Ej. R001"
                                   GridPane.rowIndex="0"
                                   GridPane.columnIndex="1"/>

                        <Label text="Canal:"
                               GridPane.rowIndex="0"
                               GridPane.columnIndex="2"/>

                        <ComboBox fx:id="cbCanal"
                                  prefWidth="220"
                                  GridPane.rowIndex="0"
                                  GridPane.columnIndex="3"/>

                        <Label text="Huésped:"
                               GridPane.rowIndex="1"
                               GridPane.columnIndex="0"/>

                        <ComboBox fx:id="cbHuesped"
                                  promptText="Selecciona un huésped"
                                  prefWidth="220"
                                  GridPane.rowIndex="1"
                                  GridPane.columnIndex="1"/>

                        <Label text="Apartamento:"
                               GridPane.rowIndex="1"
                               GridPane.columnIndex="2"/>

                        <ComboBox fx:id="cbApartamento"
                                  promptText="Selecciona apartamento"
                                  prefWidth="220"
                                  GridPane.rowIndex="1"
                                  GridPane.columnIndex="3"/>

                        <Label text="Entrada:"
                               GridPane.rowIndex="2"
                               GridPane.columnIndex="0"/>

                        <DatePicker fx:id="dpEntrada"
                                    GridPane.rowIndex="2"
                                    GridPane.columnIndex="1"/>

                        <Label text="Salida:"
                               GridPane.rowIndex="2"
                               GridPane.columnIndex="2"/>

                        <DatePicker fx:id="dpSalida"
                                    GridPane.rowIndex="2"
                                    GridPane.columnIndex="3"/>

                        <HBox spacing="10"
                              GridPane.rowIndex="3"
                              GridPane.columnIndex="1"
                              GridPane.columnSpan="3">

                            <Button text="Consultar disponibilidad"
                                    onAction="#consultarDisponibilidad"/>

                            <Button text="Registrar reserva"
                                    onAction="#registrarReserva"
                                    style="-fx-background-color: #243447;
                                           -fx-text-fill: white;"/>

                            <Button text="Actualizar listas"
                                    onAction="#actualizarDatos"/>
                        </HBox>
                    </GridPane>
                </content>
            </TitledPane>

            <!-- RESERVA GRUPAL -->
            <TitledPane text="Registrar reserva familiar o grupal"
                        collapsible="false"
                        expanded="true">
                <content>
                    <VBox spacing="12">
                        <padding>
                            <Insets top="15" right="15" bottom="15" left="15"/>
                        </padding>

                        <Label text="1. Información de la reserva"
                               style="-fx-font-size: 16px;
                                      -fx-font-weight: bold;"/>

                        <GridPane hgap="12" vgap="10">
                            <Label text="Código base:"
                                   GridPane.rowIndex="0"
                                   GridPane.columnIndex="0"/>

                            <TextField fx:id="txtCodigoGrupo"
                                       promptText="Ej. FAM001"
                                       GridPane.rowIndex="0"
                                       GridPane.columnIndex="1"/>

                            <Label text="Canal:"
                                   GridPane.rowIndex="0"
                                   GridPane.columnIndex="2"/>

                            <ComboBox fx:id="cbCanalGrupo"
                                      prefWidth="180"
                                      GridPane.rowIndex="0"
                                      GridPane.columnIndex="3"/>

                            <Label text="Entrada:"
                                   GridPane.rowIndex="1"
                                   GridPane.columnIndex="0"/>

                            <DatePicker fx:id="dpEntradaGrupo"
                                        GridPane.rowIndex="1"
                                        GridPane.columnIndex="1"/>

                            <Label text="Salida:"
                                   GridPane.rowIndex="1"
                                   GridPane.columnIndex="2"/>

                            <DatePicker fx:id="dpSalidaGrupo"
                                        GridPane.rowIndex="1"
                                        GridPane.columnIndex="3"/>
                        </GridPane>

                        <Separator/>

                        <Label text="2. Seleccionar huéspedes"
                               style="-fx-font-size: 16px;
                                      -fx-font-weight: bold;"/>

                        <Label text="Selecciona uno o varios huéspedes de la lista."/>

                        <ListView fx:id="lvHuespedesDisponibles"
                                  prefHeight="120"
                                  maxHeight="150"/>

                        <Button text="Agregar huéspedes seleccionados al grupo"
                                onAction="#agregarHuespedesGrupo"
                                maxWidth="Infinity"/>

                        <Separator/>

                        <Label text="3. Seleccionar apartamentos"
                               style="-fx-font-size: 16px;
                                      -fx-font-weight: bold;"/>

                        <Label text="Selecciona los apartamentos que utilizará el grupo."/>

                        <ListView fx:id="lvApartamentosDisponibles"
                                  prefHeight="100"
                                  maxHeight="130"/>

                        <Button text="Agregar apartamentos seleccionados al grupo"
                                onAction="#agregarApartamentosGrupo"
                                maxWidth="Infinity"/>

                        <Separator/>

                        <Label text="4. Asignar huéspedes a apartamentos"
                               style="-fx-font-size: 16px;
                                      -fx-font-weight: bold;"/>

                        <GridPane hgap="12" vgap="10">
                            <Label text="Huésped:"
                                   GridPane.rowIndex="0"
                                   GridPane.columnIndex="0"/>

                            <ComboBox fx:id="cbHuespedGrupo"
                                      promptText="Huésped del grupo"
                                      prefWidth="220"
                                      GridPane.rowIndex="0"
                                      GridPane.columnIndex="1"/>

                            <Label text="Apartamento:"
                                   GridPane.rowIndex="0"
                                   GridPane.columnIndex="2"/>

                            <ComboBox fx:id="cbApartamentoGrupo"
                                      promptText="Apartamento del grupo"
                                      prefWidth="220"
                                      GridPane.rowIndex="0"
                                      GridPane.columnIndex="3"/>
                        </GridPane>

                        <Button text="Asignar huésped al apartamento"
                                onAction="#asignarHuespedGrupo"
                                maxWidth="Infinity"/>

                        <Label text="Asignaciones realizadas:"
                               style="-fx-font-weight: bold;"/>

                        <ListView fx:id="lvAsignacionesGrupo"
                                  prefHeight="110"
                                  maxHeight="130"/>

                        <Separator/>

                        <Button text="Registrar reserva familiar o grupal"
                                onAction="#registrarReservaGrupal"
                                maxWidth="Infinity"
                                style="-fx-background-color: #28784B;
                                       -fx-text-fill: white;
                                       -fx-font-weight: bold;"/>

                        <Button text="Limpiar grupo"
                                onAction="#limpiarGrupo"
                                maxWidth="Infinity"/>

                        <Label fx:id="lblEstadoGrupo"
                               text="Crea un grupo agregando huéspedes y apartamentos."
                               wrapText="true"
                               style="-fx-text-fill: #455A64;"/>
                    </VBox>
                </content>
            </TitledPane>

            <!-- CONSULTA DE RESERVAS -->
            <Label text="Reservas registradas"
                   style="-fx-font-size: 19px;
                          -fx-font-weight: bold;"/>

            <HBox spacing="10">
                <TextField fx:id="txtBuscar"
                           promptText="Código de reserva"
                           HBox.hgrow="ALWAYS"/>

                <Button text="Buscar"
                        onAction="#buscarReserva"/>

                <Button text="Mostrar todas"
                        onAction="#mostrarTodas"/>

                <Button text="Cancelar seleccionada"
                        onAction="#cancelarSeleccionada"/>
            </HBox>

            <TableView fx:id="tablaReservas"
                       prefHeight="270"
                       VBox.vgrow="ALWAYS">

                <columns>
                    <TableColumn fx:id="colCodigo"
                                 text="Código"
                                 prefWidth="115"/>

                    <TableColumn fx:id="colHuesped"
                                 text="Huéspedes"
                                 prefWidth="190"/>

                    <TableColumn fx:id="colApartamento"
                                 text="Apto."
                                 prefWidth="80"/>

                    <TableColumn fx:id="colEntrada"
                                 text="Entrada"
                                 prefWidth="105"/>

                    <TableColumn fx:id="colSalida"
                                 text="Salida"
                                 prefWidth="105"/>

                    <TableColumn fx:id="colCanal"
                                 text="Canal"
                                 prefWidth="85"/>

                    <TableColumn fx:id="colEstado"
                                 text="Estado"
                                 prefWidth="120"/>
                </columns>
            </TableView>

            <!-- ACCIONES ECONÓMICAS -->
            <HBox spacing="10">
                <Button text="Cotizar reserva"
                        onAction="#cotizarSeleccionada"
                        style="-fx-background-color: #243447;
                               -fx-text-fill: white;"/>

                <Button text="Registrar pago"
                        onAction="#registrarPagoSeleccionada"
                        style="-fx-background-color: #28784B;
                               -fx-text-fill: white;"/>

                <Button text="Pagar saldo"
                        onAction="#pagarSaldoSeleccionada"
                        style="-fx-background-color: #28784B;
                               -fx-text-fill: white;"/>

                <Button text="Confirmar reserva"
                        onAction="#confirmarSeleccionada"
                        style="-fx-background-color: #28784B;
                               -fx-text-fill: white;"/>

                <Button text="Registrar cargo"
                        onAction="#registrarCargoSeleccionada"/>

                <Button text="Consultar folio"
                        onAction="#consultarFolioSeleccionada"/>
            </HBox>

            <Label fx:id="lblEstado"
                   wrapText="true"
                   text="Selecciona un huésped y un apartamento."
                   style="-fx-text-fill: #455A64;"/>

        </VBox>
    </content>
</ScrollPane>
