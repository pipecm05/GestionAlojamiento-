<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="co.edu.uniquindio.gestionalojamiento.controladores.PrincipalController"
        fx:id="panelPrincipal"
        prefWidth="1200.0"
        prefHeight="750.0"
        style="-fx-background-color: #F4F6F9;">

    <top>
        <HBox
                alignment="CENTER_LEFT"
                spacing="15.0"
                prefHeight="70.0"
                style="-fx-background-color: #243447;">

            <padding>
                <Insets top="10.0" right="25.0" bottom="10.0" left="25.0"/>
            </padding>

            <Label
                    text="GESTIÓN DE ALOJAMIENTO"
                    style="-fx-font-size: 22px;
                           -fx-font-weight: bold;
                           -fx-text-fill: white;"/>

            <Label
                    text="Aparta-Suites UQ"
                    style="-fx-font-size: 14px;
                           -fx-text-fill: #CFD8DC;"/>
        </HBox>
    </top>

    <left>
        <ScrollPane
                prefWidth="230.0"
                fitToWidth="true"
                hbarPolicy="NEVER"
                vbarPolicy="AS_NEEDED"
                style="-fx-background-color: white;
                       -fx-background: white;
                       -fx-border-color: transparent;">

            <content>
                <VBox
                        spacing="8.0"
                        prefWidth="210.0"
                        style="-fx-background-color: white;">

                    <padding>
                        <Insets top="20.0" right="12.0" bottom="20.0" left="12.0"/>
                    </padding>

                    <Label
                            text="MENÚ PRINCIPAL"
                            style="-fx-font-size: 13px;
                                   -fx-font-weight: bold;
                                   -fx-text-fill: #78909C;"/>

                    <Button
                            text="Inicio"
                            onAction="#mostrarInicio"
                            maxWidth="Infinity"
                            style="-fx-background-color: #EAF0F6;
                                   -fx-text-fill: #243447;
                                   -fx-font-size: 14px;
                                   -fx-alignment: CENTER_LEFT;"/>

                    <Button
                            text="Alojamientos"
                            onAction="#mostrarAlojamientos"
                            maxWidth="Infinity"
                            style="-fx-background-color: transparent;
                                   -fx-text-fill: #243447;
                                   -fx-font-size: 14px;
                                   -fx-alignment: CENTER_LEFT;"/>

                    <Button
                            text="Huéspedes"
                            onAction="#mostrarHuespedes"
                            maxWidth="Infinity"
                            style="-fx-background-color: transparent;
                                   -fx-text-fill: #243447;
                                   -fx-font-size: 14px;
                                   -fx-alignment: CENTER_LEFT;"/>

                    <Button
                            text="Empleados"
                            onAction="#mostrarEmpleados"
                            maxWidth="Infinity"
                            style="-fx-background-color: transparent;
                                   -fx-text-fill: #243447;
                                   -fx-font-size: 14px;
                                   -fx-alignment: CENTER_LEFT;"/>

                    <Button
                            text="Turnos"
                            onAction="#mostrarTurnos"
                            maxWidth="Infinity"
                            style="-fx-background-color: transparent;
                                   -fx-text-fill: #243447;
                                   -fx-font-size: 14px;
                                   -fx-alignment: CENTER_LEFT;"/>

                    <Button
                            text="Favoritos"
                            onAction="#mostrarFavoritos"
                            maxWidth="Infinity"
                            style="-fx-background-color: transparent;
                                   -fx-text-fill: #243447;
                                   -fx-font-size: 14px;
                                   -fx-alignment: CENTER_LEFT;"/>

                    <Button
                            text="Reservas"
                            onAction="#mostrarReservas"
                            maxWidth="Infinity"
                            style="-fx-background-color: transparent;
                                   -fx-text-fill: #243447;
                                   -fx-font-size: 14px;
                                   -fx-alignment: CENTER_LEFT;"/>

                    <Button
                            text="Portal del huésped"
                            onAction="#mostrarPortalHuesped"
                            maxWidth="Infinity"
                            style="-fx-background-color: #E3F2FD;
                                   -fx-text-fill: #1565C0;
                                   -fx-font-weight: bold;
                                   -fx-font-size: 14px;
                                   -fx-alignment: CENTER_LEFT;"/>

                    <Button
                            text="Canal externo"
                            onAction="#mostrarCanalExterno"
                            maxWidth="Infinity"
                            style="-fx-background-color: #EAF0F6;
                                   -fx-text-fill: #243447;
                                   -fx-font-size: 14px;
                                   -fx-alignment: CENTER_LEFT;"/>

                    <Button
                            text="Calendario de ocupación"
                            onAction="#mostrarCalendario"
                            maxWidth="Infinity"
                            style="-fx-background-color: #EAF0F6;
                                   -fx-text-fill: #243447;
                                   -fx-font-size: 14px;
                                   -fx-alignment: CENTER_LEFT;"/>

                    <Button
                            text="Folio"
                            onAction="#mostrarFolio"
                            maxWidth="Infinity"
                            style="-fx-background-color: transparent;
                                   -fx-text-fill: #243447;
                                   -fx-font-size: 14px;
                                   -fx-alignment: CENTER_LEFT;"/>

                    <Button
                            text="Preparación"
                            onAction="#mostrarPreparacion"
                            maxWidth="Infinity"
                            style="-fx-background-color: transparent;
                                   -fx-text-fill: #243447;
                                   -fx-font-size: 14px;
                                   -fx-alignment: CENTER_LEFT;"/>

                    <Button
                            text="Temporadas"
                            onAction="#mostrarTemporadas"
                            maxWidth="Infinity"
                            style="-fx-background-color: transparent;
                                   -fx-text-fill: #243447;
                                   -fx-font-size: 14px;
                                   -fx-alignment: CENTER_LEFT;"/>

                    <Button
                            text="Mapa y rutas"
                            onAction="#mostrarMapa"
                            maxWidth="Infinity"
                            style="-fx-background-color: #EAF0F6;
                                   -fx-text-fill: #243447;
                                   -fx-font-weight: bold;
                                   -fx-font-size: 14px;
                                   -fx-alignment: CENTER_LEFT;"/>

                    <Button
                            text="Reportes"
                            onAction="#mostrarReportes"
                            maxWidth="Infinity"
                            style="-fx-background-color: transparent;
                                   -fx-text-fill: #243447;
                                   -fx-font-size: 14px;
                                   -fx-alignment: CENTER_LEFT;"/>

                    <Label
                            text="Sistema de Gestión"
                            style="-fx-font-size: 11px;
                                   -fx-text-fill: #90A4AE;"/>

                </VBox>
            </content>
        </ScrollPane>
    </left>

    <center>
        <VBox
                fx:id="contenidoCentral"
                spacing="15.0"
                style="-fx-background-color: #F4F6F9;">

            <padding>
                <Insets top="25.0" right="25.0" bottom="25.0" left="25.0"/>
            </padding>

        </VBox>
    </center>

</BorderPane>
