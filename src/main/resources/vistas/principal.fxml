<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="co.edu.uniquindio.gestionalojamiento.controladores.PrincipalController"
        fx:id="panelPrincipal"
        prefWidth="1100"
        prefHeight="700">

    <left>
        <VBox spacing="12"
              prefWidth="230"
              style="-fx-background-color: #243447;">

            <padding>
                <Insets top="25" right="15" bottom="20" left="15"/>
            </padding>

            <Label text="GESTIÓN DE ALOJAMIENTOS"
                   wrapText="true"
                   style="-fx-text-fill: white;
                          -fx-font-size: 18px;
                          -fx-font-weight: bold;"/>

            <Button text="Inicio"
                    maxWidth="Infinity"
                    onAction="#mostrarInicio"/>

            <Button text="Alojamientos"
                    maxWidth="Infinity"
                    onAction="#mostrarAlojamientos"/>

            <Button text="Huéspedes"
                    maxWidth="Infinity"
                    onAction="#mostrarHuespedes"/>

            <Button text="Empleados"
                    maxWidth="Infinity"
                    onAction="#mostrarEmpleados"/>

            <Button text="Reservas"
                    maxWidth="Infinity"
                    onAction="#mostrarReservas"/>

            <Button text="Temporadas"
                    maxWidth="Infinity"
                    onAction="#mostrarTemporadas"/>

            <Button text="Preparación"
                    maxWidth="Infinity"
                    onAction="#mostrarPreparacion"/>

            <Button text="Reportes"
                    maxWidth="Infinity"
                    onAction="#mostrarReportes"/>

        </VBox>
    </left>

    <center>
        <VBox fx:id="contenidoCentral"
              spacing="20"
              style="-fx-background-color: #F4F6F9;">

            <padding>
                <Insets top="35" right="35"
                        bottom="35" left="35"/>
            </padding>

            <Label text="Panel principal"
                   style="-fx-font-size: 28px;
                          -fx-font-weight: bold;"/>

            <Label text="Sistema de gestión de alojamiento"
                   style="-fx-font-size: 16px;"/>

            <Label text="Bienvenido. Selecciona una opción del menú para comenzar."
                   wrapText="true"/>

        </VBox>
    </center>

</BorderPane>
