<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="co.edu.uniquindio.gestionalojamiento.controladores.PortalHuespedController"
        fitToWidth="true"
        hbarPolicy="NEVER"
        vbarPolicy="AS_NEEDED"
        style="-fx-background-color: #F4F6F9;">

    <content>
        <VBox spacing="18.0"
              style="-fx-background-color: #F4F6F9;">

            <padding>
                <Insets top="25" right="25" bottom="30" left="25"/>
            </padding>

            <Label text="PORTAL DEL HUÉSPED"
                   style="-fx-font-size: 26px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #243447;"/>

            <Label fx:id="lblBienvenida"
                   text="Selecciona tu perfil para comenzar."
                   style="-fx-font-size: 16px;
                          -fx-text-fill: #455A64;"/>

            <VBox spacing="8">
                <Label text="Seleccionar huésped"
                       style="-fx-font-weight: bold;"/>

                <ComboBox fx:id="cmbHuesped"
                          promptText="Selecciona tu perfil"
                          prefWidth="400"
                          maxWidth="Infinity"/>
            </VBox>

            <Separator/>

            <Label text="CALENDARIO DE DISPONIBILIDAD"
                   style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #243447;"/>

            <Label text="Selecciona un apartamento para consultar sus fechas ocupadas. No se muestran datos de otras reservas."
                   wrapText="true"
                   style="-fx-text-fill: #546E7A;"/>

            <ComboBox fx:id="cmbApartamentoCalendario"
                      promptText="Selecciona un apartamento"
                      prefWidth="350"/>

            <HBox spacing="12" alignment="CENTER">
                <Button text="‹ Mes anterior"
                        onAction="#mesAnteriorCalendario"/>

                <Label fx:id="lblMesCalendario"
                       text="Mes"
                       prefWidth="220"
                       style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-alignment: center;"/>

                <Button text="Mes siguiente ›"
                        onAction="#mesSiguienteCalendario"/>
            </HBox>

            <GridPane fx:id="gridCalendario"
                      hgap="8"
                      vgap="8"
                      maxWidth="560"
                      style="-fx-padding: 8;"/>

            <HBox spacing="18" alignment="CENTER_LEFT">
                <Label text="■ Ocupado"
                       style="-fx-text-fill: #842029; -fx-font-weight: bold;"/>

                <Label text="■ Disponible"
                       style="-fx-text-fill: #0F5132; -fx-font-weight: bold;"/>
            </HBox>

            <Separator/>

            <Label text="BUSCAR ALOJAMIENTOS"
                   style="-fx-font-size: 18px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #243447;"/>

            <HBox spacing="15" alignment="CENTER_LEFT">

                <VBox spacing="6">
                    <Label text="Fecha de entrada"/>
                    <DatePicker fx:id="dpEntrada"
                                prefWidth="170"/>
                </VBox>

                <VBox spacing="6">
                    <Label text="Fecha de salida"/>
                    <DatePicker fx:id="dpSalida"
                                prefWidth="170"/>
                </VBox>

                <VBox spacing="6">
                    <Label text="Cantidad de personas"/>
                    <Spinner fx:id="spPersonas"
                             prefWidth="110"/>
                </VBox>

                <Button text="Buscar disponibilidad"
                        onAction="#buscarAlojamientos"
                        style="-fx-background-color: #243447;
                               -fx-text-fill: white;
                               -fx-font-weight: bold;"/>
            </HBox>

            <Label fx:id="lblResultado"
                   text="Selecciona las fechas para consultar los apartamentos."
                   style="-fx-text-fill: #546E7A;"/>

            <TableView fx:id="tablaAlojamientos"
                       prefHeight="220">

                <columns>
                    <TableColumn fx:id="colCodigoAlojamiento"
                                 text="Código"
                                 prefWidth="100"/>

                    <TableColumn fx:id="colNombreAlojamiento"
                                 text="Apartamento"
                                 prefWidth="180"/>

                    <TableColumn fx:id="colCapacidad"
                                 text="Capacidad"
                                 prefWidth="100"/>

                    <TableColumn fx:id="colHabitaciones"
                                 text="Habitaciones"
                                 prefWidth="110"/>

                    <TableColumn fx:id="colTarifa"
                                 text="Tarifa base por persona"
                                 prefWidth="160"/>
                </columns>
            </TableView>

            <HBox spacing="12">
                <Button text="Solicitar reserva"
                        onAction="#solicitarReserva"
                        style="-fx-background-color: #2E7D32;
                               -fx-text-fill: white;
                               -fx-font-weight: bold;"/>

                <Button text="Agregar a favoritos"
                        onAction="#agregarFavorito"
                        style="-fx-background-color: #E3F2FD;
                               -fx-text-fill: #1565C0;
                               -fx-font-weight: bold;"/>
            </HBox>

            <Separator/>

            <Label text="MIS RESERVAS"
                   style="-fx-font-size: 18px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #243447;"/>

            <Label text="Selecciona una reserva para consultar su desglose y anticipo."
                   style="-fx-text-fill: #546E7A;"/>

            <TableView fx:id="tablaReservas"
                       prefHeight="200">

                <columns>
                    <TableColumn fx:id="colCodigoReserva"
                                 text="Código"
                                 prefWidth="130"/>

                    <TableColumn fx:id="colApartamentoReserva"
                                 text="Apartamento"
                                 prefWidth="180"/>

                    <TableColumn fx:id="colFechasReserva"
                                 text="Fechas"
                                 prefWidth="220"/>

                    <TableColumn fx:id="colEstadoReserva"
                                 text="Estado"
                                 prefWidth="120"/>
                </columns>
            </TableView>

            <Separator/>

            <Label text="DESGLOSE DE TARIFAS"
                   style="-fx-font-size: 18px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #243447;"/>

            <Label text="El valor de cada noche depende de la temporada correspondiente."
                   style="-fx-text-fill: #546E7A;"/>

            <TableView fx:id="tablaDesglose"
                       prefHeight="200">

                <columns>
                    <TableColumn fx:id="colFechaDesglose"
                                 text="Fecha"
                                 prefWidth="120"/>

                    <TableColumn fx:id="colTemporadaDesglose"
                                 text="Temporada"
                                 prefWidth="120"/>

                    <TableColumn fx:id="colPersonasDesglose"
                                 text="Personas que pagan"
                                 prefWidth="150"/>

                    <TableColumn fx:id="colTarifaDesglose"
                                 text="Tarifa por persona"
                                 prefWidth="150"/>

                    <TableColumn fx:id="colSubtotalDesglose"
                                 text="Subtotal noche"
                                 prefWidth="150"/>
                </columns>
            </TableView>

            <VBox spacing="10"
                  style="-fx-background-color: white;
                         -fx-padding: 18;
                         -fx-background-radius: 8;
                         -fx-border-color: #DCE3EA;
                         -fx-border-radius: 8;">

                <Label text="RESUMEN DE PAGO"
                       style="-fx-font-size: 17px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #243447;"/>

                <HBox spacing="10">
                    <Label text="Total de la reserva:"
                           style="-fx-font-weight: bold;"/>

                    <Label fx:id="lblTotalReserva"
                           text="0"/>
                </HBox>

                <HBox spacing="10">
                    <Label text="Anticipo requerido (30 %):"
                           style="-fx-font-weight: bold;"/>

                    <Label fx:id="lblAnticipo"
                           text="0"/>
                </HBox>

                <HBox spacing="10">
                    <Label text="Saldo pendiente:"
                           style="-fx-font-weight: bold;"/>

                    <Label fx:id="lblSaldoPendiente"
                           text="0"/>
                </HBox>

                <Label fx:id="lblEstadoPago"
                       text="Selecciona una reserva para consultar sus valores."
                       wrapText="true"
                       style="-fx-text-fill: #546E7A;"/>

                <Button text="Registrar anticipo del 30 % y confirmar reserva"
                        onAction="#pagarAnticipoYConfirmar"
                        maxWidth="Infinity"
                        style="-fx-background-color: #2E7D32;
                               -fx-text-fill: white;
                               -fx-font-weight: bold;"/>
            </VBox>

            <Separator/>

            <Label text="MIS FAVORITOS"
                   style="-fx-font-size: 18px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #243447;"/>

            <TableView fx:id="tablaFavoritos"
                       prefHeight="180">

                <columns>
                    <TableColumn fx:id="colCodigoFavorito"
                                 text="Código"
                                 prefWidth="130"/>

                    <TableColumn fx:id="colNombreFavorito"
                                 text="Apartamento"
                                 prefWidth="200"/>

                    <TableColumn fx:id="colCapacidadFavorito"
                                 text="Capacidad"
                                 prefWidth="130"/>
                </columns>
            </TableView>

            <Button text="Eliminar de favoritos"
                    onAction="#eliminarFavorito"
                    style="-fx-background-color: #FFEBEE;
                           -fx-text-fill: #C62828;
                           -fx-font-weight: bold;"
                    maxWidth="220"/>

        </VBox>
    </content>
</ScrollPane>
