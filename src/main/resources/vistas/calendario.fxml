<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<ScrollPane
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fitToWidth="true"
        hbarPolicy="NEVER"
        style="-fx-background: #F4F6F9;
               -fx-background-color: #F4F6F9;"
        fx:controller="co.edu.uniquindio.gestionalojamiento.controladores.CalendarioController">

    <content>
        <VBox spacing="18.0"
              style="-fx-background-color: #F4F6F9;">

            <padding>
                <Insets top="25" right="25" bottom="25" left="25"/>
            </padding>

            <VBox spacing="5">
                <Label text="Calendario de ocupación"
                       style="-fx-font-size: 26px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #243447;"/>

                <Label text="Consulta la disponibilidad de los apartamentos por fecha."
                       wrapText="true"
                       style="-fx-font-size: 14px;
                              -fx-text-fill: #607D8B;"/>
            </VBox>

            <HBox alignment="CENTER" spacing="12">
                <Button text="◀"
                        onAction="#mesAnterior"
                        prefWidth="45"
                        style="-fx-background-color: #243447;
                               -fx-text-fill: white;
                               -fx-background-radius: 6;"/>

                <Label fx:id="lblMes"
                       text="MES"
                       minWidth="220"
                       alignment="CENTER"
                       style="-fx-font-size: 19px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #243447;"/>

                <Button text="▶"
                        onAction="#mesSiguiente"
                        prefWidth="45"
                        style="-fx-background-color: #243447;
                               -fx-text-fill: white;
                               -fx-background-radius: 6;"/>

                <Button text="Hoy"
                        onAction="#irAHoy"
                        style="-fx-background-color: #DCE6F1;
                               -fx-text-fill: #243447;
                               -fx-font-weight: bold;
                               -fx-background-radius: 6;"/>
            </HBox>

            <GridPane hgap="6" vgap="6">
                <columnConstraints>
                    <ColumnConstraints percentWidth="14.2857" hgrow="ALWAYS"/>
                    <ColumnConstraints percentWidth="14.2857" hgrow="ALWAYS"/>
                    <ColumnConstraints percentWidth="14.2857" hgrow="ALWAYS"/>
                    <ColumnConstraints percentWidth="14.2857" hgrow="ALWAYS"/>
                    <ColumnConstraints percentWidth="14.2857" hgrow="ALWAYS"/>
                    <ColumnConstraints percentWidth="14.2857" hgrow="ALWAYS"/>
                    <ColumnConstraints percentWidth="14.2857" hgrow="ALWAYS"/>
                </columnConstraints>

                <Label text="LUN" GridPane.columnIndex="0"
                       maxWidth="Infinity" alignment="CENTER"
                       style="-fx-font-weight: bold; -fx-text-fill: #455A64;"/>
                <Label text="MAR" GridPane.columnIndex="1"
                       maxWidth="Infinity" alignment="CENTER"
                       style="-fx-font-weight: bold; -fx-text-fill: #455A64;"/>
                <Label text="MIÉ" GridPane.columnIndex="2"
                       maxWidth="Infinity" alignment="CENTER"
                       style="-fx-font-weight: bold; -fx-text-fill: #455A64;"/>
                <Label text="JUE" GridPane.columnIndex="3"
                       maxWidth="Infinity" alignment="CENTER"
                       style="-fx-font-weight: bold; -fx-text-fill: #455A64;"/>
                <Label text="VIE" GridPane.columnIndex="4"
                       maxWidth="Infinity" alignment="CENTER"
                       style="-fx-font-weight: bold; -fx-text-fill: #455A64;"/>
                <Label text="SÁB" GridPane.columnIndex="5"
                       maxWidth="Infinity" alignment="CENTER"
                       style="-fx-font-weight: bold; -fx-text-fill: #455A64;"/>
                <Label text="DOM" GridPane.columnIndex="6"
                       maxWidth="Infinity" alignment="CENTER"
                       style="-fx-font-weight: bold; -fx-text-fill: #455A64;"/>
            </GridPane>

            <GridPane fx:id="gridCalendario"
                      hgap="6"
                      vgap="6"
                      style="-fx-background-color: white;
                             -fx-padding: 10;
                             -fx-background-radius: 10;">

                <columnConstraints>
                    <ColumnConstraints percentWidth="14.2857" hgrow="ALWAYS"/>
                    <ColumnConstraints percentWidth="14.2857" hgrow="ALWAYS"/>
                    <ColumnConstraints percentWidth="14.2857" hgrow="ALWAYS"/>
                    <ColumnConstraints percentWidth="14.2857" hgrow="ALWAYS"/>
                    <ColumnConstraints percentWidth="14.2857" hgrow="ALWAYS"/>
                    <ColumnConstraints percentWidth="14.2857" hgrow="ALWAYS"/>
                    <ColumnConstraints percentWidth="14.2857" hgrow="ALWAYS"/>
                </columnConstraints>
            </GridPane>

            <VBox spacing="10"
                  style="-fx-background-color: white;
                         -fx-padding: 15;
                         -fx-background-radius: 10;">

                <Label text="Leyenda"
                       style="-fx-font-size: 15px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #243447;"/>

                <HBox spacing="14">
                    <Label text="● Disponible"
                           style="-fx-text-fill: #39834B;"/>
                    <Label text="● Ocupado"
                           style="-fx-text-fill: #C62828;"/>
                    <Label text="● Reservado"
                           style="-fx-text-fill: #B8860B;"/>
                </HBox>

                <HBox spacing="14">
                    <Label text="● Preparación"
                           style="-fx-text-fill: #E07819;"/>
                    <Label text="● Fuera de servicio"
                           style="-fx-text-fill: #68727D;"/>
                    <Label text="● Finalizado"
                           style="-fx-text-fill: #607D8B;"/>
                </HBox>
            </VBox>

            <VBox spacing="10"
                  style="-fx-background-color: white;
                         -fx-padding: 18;
                         -fx-background-radius: 10;">

                <Label text="Detalle de la fecha seleccionada"
                       style="-fx-font-size: 17px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #243447;"/>

                <Label fx:id="lblFechaSeleccionada"
                       text="Fecha seleccionada"
                       wrapText="true"
                       style="-fx-font-size: 14px;
                              -fx-text-fill: #455A64;"/>

                <Label fx:id="lblResumen"
                       text="Resumen de disponibilidad"
                       wrapText="true"
                       style="-fx-font-size: 13px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #243447;"/>

                <VBox fx:id="contenedorDetalle" spacing="7"/>
            </VBox>

        </VBox>
    </content>
</ScrollPane>
