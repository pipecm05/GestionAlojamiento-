<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="co.edu.uniquindio.gestionalojamiento.controladores.FavoritosController"
      spacing="18"
      style="-fx-background-color: #F4F6F9;">

    <padding>
        <Insets top="30" right="35" bottom="30" left="35"/>
    </padding>

    <Label text="Gestión de favoritos"
           style="-fx-font-size: 27px; -fx-font-weight: bold; -fx-text-fill: #243447;"/>

    <Label text="Selecciona un huésped y un apartamento para administrar sus favoritos."
           wrapText="true"
           style="-fx-font-size: 14px;"/>

    <VBox spacing="8">
        <Label text="Huésped"
               style="-fx-font-weight: bold;"/>

        <ComboBox fx:id="cmbHuesped"
                  promptText="Seleccionar huésped"
                  maxWidth="Infinity"/>
    </VBox>

    <VBox spacing="8">
        <Label text="Apartamento"
               style="-fx-font-weight: bold;"/>

        <ComboBox fx:id="cmbApartamento"
                  promptText="Seleccionar apartamento"
                  maxWidth="Infinity"/>
    </VBox>

    <HBox spacing="10">
        <Button text="Agregar favorito"
                onAction="#agregarFavorito"
                style="-fx-background-color: #243447; -fx-text-fill: white;"/>

        <Button text="Consultar favoritos"
                onAction="#consultarFavoritos"/>

        <Button text="Eliminar seleccionado"
                onAction="#eliminarFavorito"
                style="-fx-background-color: #B33A3A; -fx-text-fill: white;"/>

        <Button text="Limpiar"
                onAction="#limpiarSeleccion"/>
    </HBox>

    <Label text="Favoritos registrados"
           style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <TableView fx:id="tablaFavoritos"
               VBox.vgrow="ALWAYS">

        <columns>
            <TableColumn fx:id="colDocumento"
                         text="Documento"
                         prefWidth="110"/>

            <TableColumn fx:id="colHuesped"
                         text="Huésped"
                         prefWidth="170"/>

            <TableColumn fx:id="colCodigo"
                         text="Código"
                         prefWidth="100"/>

            <TableColumn fx:id="colApartamento"
                         text="Apartamento"
                         prefWidth="170"/>

            <TableColumn fx:id="colFecha"
                         text="Fecha agregado"
                         prefWidth="160"/>
        </columns>
    </TableView>

    <Label fx:id="lblCantidad"
           text="Total de favoritos: 0"
           style="-fx-font-size: 14px; -fx-font-weight: bold;"/>

</VBox>
