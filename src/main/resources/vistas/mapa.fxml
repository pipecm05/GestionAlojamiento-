<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.edu.uniquindio.gestionalojamiento.controladores.MapaController"
            fitToWidth="true"
            hbarPolicy="NEVER"
            vbarPolicy="AS_NEEDED"
            style="-fx-background: #F4F6F9;">

    <content>
        <VBox spacing="18"
              style="-fx-background-color: #F4F6F9;">

            <padding>
                <Insets top="25" right="25" bottom="25" left="25"/>
            </padding>

            <Label text="Mapa y gestión de rutas"
                   style="-fx-font-size: 26px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #243447;"/>

            <Label text="Visualiza las ubicaciones, sus conexiones y los recorridos del complejo."
                   wrapText="true"/>

            <TitledPane text="Mapa de ubicaciones"
                        collapsible="false"
                        expanded="true">

                <content>
                    <VBox spacing="12">
                        <padding>
                            <Insets top="12" right="12" bottom="12" left="12"/>
                        </padding>

                        <FlowPane hgap="18" vgap="10">
                            <Label text="● Recepción"
                                   style="-fx-text-fill: #16845B; -fx-font-weight: bold;"/>

                            <Label text="● Apartamentos"
                                   style="-fx-text-fill: #2878A8; -fx-font-weight: bold;"/>

                            <Label text="● Escaleras"
                                   style="-fx-text-fill: #7C3AED; -fx-font-weight: bold;"/>

                            <Label text="● Zonas de aseo"
                                   style="-fx-text-fill: #0891B2; -fx-font-weight: bold;"/>

                            <Label text="● Ruta resaltada"
                                   style="-fx-text-fill: #F59E0B; -fx-font-weight: bold;"/>
                        </FlowPane>

                        <ScrollPane fitToWidth="true"
                                    fitToHeight="false"
                                    hbarPolicy="AS_NEEDED"
                                    vbarPolicy="AS_NEEDED"
                                    prefViewportWidth="850"
                                    prefViewportHeight="480"
                                    style="-fx-background-color: white;
                                           -fx-background: white;">

                            <content>
                                <Pane fx:id="panelGrafo"
                                      prefWidth="900"
                                      minWidth="900"
                                      prefHeight="480"
                                      minHeight="480"
                                      style="-fx-background-color: white;
                                             -fx-border-color: #DCE3E9;
                                             -fx-border-radius: 8;
                                             -fx-background-radius: 8;"/>
                            </content>
                        </ScrollPane>
                    </VBox>
                </content>
            </TitledPane>

            <TitledPane text="Escenario de prueba"
                        collapsible="false"
                        expanded="true">

                <content>
                    <VBox spacing="10">
                        <padding>
                            <Insets top="12" right="12" bottom="12" left="12"/>
                        </padding>

                        <Label text="Carga una distribución de ejemplo con recepción, pasillos, escaleras, zonas de aseo y los apartamentos del catálogo."
                               wrapText="true"/>

                        <Button text="Cargar escenario de prueba"
                                onAction="#cargarEscenarioPrueba"
                                maxWidth="Infinity"
                                style="-fx-background-color: #16845B;
                                       -fx-text-fill: white;
                                       -fx-font-weight: bold;"/>
                    </VBox>
                </content>
            </TitledPane>

            <TitledPane text="1. Agregar apartamentos existentes"
                        collapsible="false"
                        expanded="true">

                <content>
                    <VBox spacing="10">
                        <padding>
                            <Insets top="12" right="12" bottom="12" left="12"/>
                        </padding>

                        <Label text="Selecciona un apartamento que ya esté registrado en el catálogo:"
                               wrapText="true"/>

                        <ComboBox fx:id="cbApartamentoDisponible"
                                  promptText="Selecciona un apartamento"
                                  maxWidth="Infinity"/>

                        <Button text="Agregar apartamento al mapa"
                                onAction="#agregarUbicacion"
                                maxWidth="Infinity"
                                style="-fx-background-color: #2878A8;
                                       -fx-text-fill: white;
                                       -fx-font-weight: bold;"/>

                        <Label text="Ubicaciones registradas:"
                               style="-fx-font-weight: bold;"/>

                        <ListView fx:id="lvUbicaciones"
                                  prefHeight="110"/>
                    </VBox>
                </content>
            </TitledPane>

            <TitledPane text="2. Conectar ubicaciones"
                        collapsible="false"
                        expanded="true">

                <content>
                    <VBox spacing="10">
                        <padding>
                            <Insets top="12" right="12" bottom="12" left="12"/>
                        </padding>

                        <Label text="Origen:"/>

                        <ComboBox fx:id="cbOrigen"
                                  promptText="Selecciona el origen"
                                  maxWidth="Infinity"/>

                        <Label text="Destino:"/>

                        <ComboBox fx:id="cbDestino"
                                  promptText="Selecciona el destino"
                                  maxWidth="Infinity"/>

                        <Label text="Distancia en metros:"/>

                        <TextField fx:id="txtDistancia"
                                   promptText="Ej. 5.5"/>

                        <Button text="Crear conexión"
                                onAction="#conectarUbicaciones"
                                maxWidth="Infinity"/>
                    </VBox>
                </content>
            </TitledPane>

            <TitledPane text="3. Ruta más corta - Dijkstra"
                        collapsible="false"
                        expanded="true">

                <content>
                    <VBox spacing="10">
                        <padding>
                            <Insets top="12" right="12" bottom="12" left="12"/>
                        </padding>

                        <Label text="Selecciona el origen y el destino en la sección de conexiones. Después consulta la ruta más corta."
                               wrapText="true"/>

                        <Button text="Consultar ruta más corta"
                                onAction="#consultarRuta"
                                maxWidth="Infinity"
                                style="-fx-background-color: #D97706;
                                       -fx-text-fill: white;
                                       -fx-font-weight: bold;"/>
                    </VBox>
                </content>
            </TitledPane>

            <TitledPane text="4. Recorridos BFS y DFS"
                        collapsible="false"
                        expanded="true">

                <content>
                    <VBox spacing="10">
                        <padding>
                            <Insets top="12" right="12" bottom="12" left="12"/>
                        </padding>

                        <Label text="Selecciona una ubicación inicial. Los recorridos visitarán todos los nodos alcanzables desde ella."
                               wrapText="true"/>

                        <ComboBox fx:id="cbOrigenRecorrido"
                                  promptText="Selecciona una ubicación"
                                  maxWidth="Infinity"/>

                        <Button text="Recorrer por anchura (BFS)"
                                onAction="#recorrerBfs"
                                maxWidth="Infinity"/>

                        <Button text="Recorrer por profundidad (DFS)"
                                onAction="#recorrerDfs"
                                maxWidth="Infinity"/>
                    </VBox>
                </content>
            </TitledPane>

            <Label text="Resultado"
                   style="-fx-font-size: 18px;
                          -fx-font-weight: bold;"/>

            <ListView fx:id="lvResultadoRuta"
                      prefHeight="150"/>

            <Label fx:id="lblResultado"
                   text="Carga el escenario de prueba para comenzar."
                   wrapText="true"
                   style="-fx-text-fill: #455A64;
                          -fx-font-weight: bold;"/>

        </VBox>
    </content>
</ScrollPane>
