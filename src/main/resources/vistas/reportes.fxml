<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.edu.uniquindio.gestionalojamiento.controladores.ReportesController"
            style="-fx-background: #F4F6F9; -fx-background-color: #F4F6F9;">

    <content>
        <VBox spacing="18" style="-fx-background-color: #F4F6F9;">
            <padding>
                <Insets top="28" right="30" bottom="30" left="30"/>
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="12">
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="Reportes administrativos"
                           style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #243447;"/>
                    <Label text="Resumen general del estado del alojamiento y sus reservas"
                           style="-fx-font-size: 13px; -fx-text-fill: #607080;"/>
                </VBox>

                <Button text="Actualizar"
                        onAction="#actualizarReportes"
                        style="-fx-background-color: #243447; -fx-text-fill: white; -fx-background-radius: 6; -fx-padding: 9 16;"/>
            </HBox>

            <GridPane hgap="14" vgap="14">
                <columnConstraints>
                    <ColumnConstraints percentWidth="33.33"/>
                    <ColumnConstraints percentWidth="33.33"/>
                    <ColumnConstraints percentWidth="33.34"/>
                </columnConstraints>

                <VBox GridPane.columnIndex="0" spacing="7"
                      style="-fx-background-color: white; -fx-background-radius: 9; -fx-padding: 18;">
                    <Label text="Total de reservas"
                           style="-fx-text-fill: #607080; -fx-font-size: 13px;"/>
                    <Label fx:id="lblTotalReservas" text="0"
                           style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #243447;"/>
                </VBox>

                <VBox GridPane.columnIndex="1" spacing="7"
                      style="-fx-background-color: white; -fx-background-radius: 9; -fx-padding: 18;">
                    <Label text="Huéspedes registrados"
                           style="-fx-text-fill: #607080; -fx-font-size: 13px;"/>
                    <Label fx:id="lblTotalHuespedes" text="0"
                           style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #243447;"/>
                </VBox>

                <VBox GridPane.columnIndex="2" spacing="7"
                      style="-fx-background-color: white; -fx-background-radius: 9; -fx-padding: 18;">
                    <Label text="Apartamentos registrados"
                           style="-fx-text-fill: #607080; -fx-font-size: 13px;"/>
                    <Label fx:id="lblTotalApartamentos" text="0"
                           style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #243447;"/>
                </VBox>
            </GridPane>

            <Label text="Reservas por estado"
                   style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #243447;"/>

            <GridPane hgap="10" vgap="10">
                <columnConstraints>
                    <ColumnConstraints percentWidth="33.33"/>
                    <ColumnConstraints percentWidth="33.33"/>
                    <ColumnConstraints percentWidth="33.34"/>
                </columnConstraints>

                <VBox GridPane.columnIndex="0" spacing="5"
                      style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 13;">
                    <Label text="Pendientes" style="-fx-text-fill: #607080;"/>
                    <Label fx:id="lblPendientes" text="0"
                           style="-fx-font-size: 22px; -fx-font-weight: bold;"/>
                </VBox>

                <VBox GridPane.columnIndex="1" spacing="5"
                      style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 13;">
                    <Label text="Confirmadas" style="-fx-text-fill: #607080;"/>
                    <Label fx:id="lblConfirmadas" text="0"
                           style="-fx-font-size: 22px; -fx-font-weight: bold;"/>
                </VBox>

                <VBox GridPane.columnIndex="2" spacing="5"
                      style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 13;">
                    <Label text="En curso" style="-fx-text-fill: #607080;"/>
                    <Label fx:id="lblEnCurso" text="0"
                           style="-fx-font-size: 22px; -fx-font-weight: bold;"/>
                </VBox>

                <VBox GridPane.columnIndex="0" GridPane.rowIndex="1" spacing="5"
                      style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 13;">
                    <Label text="Finalizadas" style="-fx-text-fill: #607080;"/>
                    <Label fx:id="lblFinalizadas" text="0"
                           style="-fx-font-size: 22px; -fx-font-weight: bold;"/>
                </VBox>

                <VBox GridPane.columnIndex="1" GridPane.rowIndex="1" spacing="5"
                      style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 13;">
                    <Label text="Canceladas" style="-fx-text-fill: #607080;"/>
                    <Label fx:id="lblCanceladas" text="0"
                           style="-fx-font-size: 22px; -fx-font-weight: bold;"/>
                </VBox>

                <VBox GridPane.columnIndex="2" GridPane.rowIndex="1" spacing="5"
                      style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 13;">
                    <Label text="No show" style="-fx-text-fill: #607080;"/>
                    <Label fx:id="lblNoShow" text="0"
                           style="-fx-font-size: 22px; -fx-font-weight: bold;"/>
                </VBox>
            </GridPane>

            <Label text="Apartamentos por estado actual"
                   style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #243447;"/>

            <GridPane hgap="10" vgap="10">
                <columnConstraints>
                    <ColumnConstraints percentWidth="33.33"/>
                    <ColumnConstraints percentWidth="33.33"/>
                    <ColumnConstraints percentWidth="33.34"/>
                </columnConstraints>

                <VBox GridPane.columnIndex="0" spacing="5"
                      style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 13;">
                    <Label text="Preparados" style="-fx-text-fill: #607080;"/>
                    <Label fx:id="lblPreparados" text="0"
                           style="-fx-font-size: 22px; -fx-font-weight: bold;"/>
                </VBox>

                <VBox GridPane.columnIndex="1" spacing="5"
                      style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 13;">
                    <Label text="Ocupados" style="-fx-text-fill: #607080;"/>
                    <Label fx:id="lblOcupados" text="0"
                           style="-fx-font-size: 22px; -fx-font-weight: bold;"/>
                </VBox>

                <VBox GridPane.columnIndex="2" spacing="5"
                      style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 13;">
                    <Label text="Pendientes de preparación" style="-fx-text-fill: #607080;"/>
                    <Label fx:id="lblPendientesPreparacion" text="0"
                           style="-fx-font-size: 22px; -fx-font-weight: bold;"/>
                </VBox>

                <VBox GridPane.columnIndex="0" GridPane.rowIndex="1" spacing="5"
                      style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 13;">
                    <Label text="En preparación" style="-fx-text-fill: #607080;"/>
                    <Label fx:id="lblEnPreparacion" text="0"
                           style="-fx-font-size: 22px; -fx-font-weight: bold;"/>
                </VBox>

                <VBox GridPane.columnIndex="1" GridPane.rowIndex="1" spacing="5"
                      style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 13;">
                    <Label text="Fuera de servicio" style="-fx-text-fill: #607080;"/>
                    <Label fx:id="lblFueraServicio" text="0"
                           style="-fx-font-size: 22px; -fx-font-weight: bold;"/>
                </VBox>
            </GridPane>

            <Label text="Detalle de reservas"
                   style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #243447;"/>

            <TableView fx:id="tablaReservas" prefHeight="330">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="colCodigo" text="Código" prefWidth="90"/>
                    <TableColumn fx:id="colApartamento" text="Apartamento" prefWidth="180"/>
                    <TableColumn fx:id="colCantidadHuespedes" text="Huéspedes" prefWidth="85"/>
                    <TableColumn fx:id="colEntrada" text="Entrada" prefWidth="95"/>
                    <TableColumn fx:id="colSalida" text="Salida" prefWidth="95"/>
                    <TableColumn fx:id="colEstado" text="Estado" prefWidth="100"/>
                </columns>
            </TableView>
        </VBox>
    </content>
</ScrollPane>
